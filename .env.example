# ---------------------------------------------------------------- Discord
#
# Du brauchst MINDESTENS EINES von beidem:
#
#   ALERT_WEBHOOK_URL  → schnellster Weg. Kein Bot, kein Token, keine Rechte.
#                        Suchen stehen dann in searches.toml.
#   DISCORD_TOKEN      → voller Bot mit Slash-Commands (/watch add …).
#
# Beides gesetzt geht auch: dann gibt es Slash-Commands, und Suchen aus
# searches.toml laufen zusätzlich über den Webhook.

# Channel-Einstellungen → Integrationen → Webhooks → Neuer Webhook → URL kopieren.
ALERT_WEBHOOK_URL=

# Suchdefinitionen für den Webhook-Modus (Vorlage: searches.example.toml).
SEARCHES_PATH=searches.toml

# Bot-Token aus dem Discord Developer Portal (Application → Bot → Reset Token).
DISCORD_TOKEN=

# Server-ID — optional. Leer lassen genügt: der Bot registriert die Befehle
# dann selbst auf allen Servern, auf denen er ist. Nur nötig, wenn er auf
# vielen Servern läuft und die Befehle bloß auf einem erscheinen sollen.
DISCORD_GUILD_ID=

# ------------------------------------------------------------- Web-Panel
# Oberfläche zum Verwalten der Suchen im Browser. Alerts kommen weiterhin
# ausschließlich in Discord an — das Panel zeigt an und verwaltet.
#
# Leeres Passwort = Panel bleibt aus. Nimm etwas Langes; die Adresse ist
# öffentlich erreichbar.
PANEL_PASSWORD=

# Domain fürs Panel. Muss per DNS-A-Eintrag auf diesen Server zeigen —
# Caddy besorgt dann automatisch ein HTTPS-Zertifikat.
PANEL_DOMAIN=vinted.elvora.me

# Nur ändern, wenn der Port schon belegt ist.
PANEL_PORT=8080

# ---------------------------------------------------------------- Polling
# Standard-Prüfintervall neuer Suchen in Sekunden.
DEFAULT_INTERVAL=60
# Untergrenze, die per /watch interval nicht unterschritten werden kann.
# Unter ~20s steigt das Sperrrisiko deutlich, ohne dass man real schneller ist.
MIN_INTERVAL=20
# Artikel pro Abfrage. 20 reicht — wer mehr braucht, pollt zu langsam.
PER_PAGE=20
# Zufälliger Anteil auf jedes Intervall (0.25 = ±25 %), damit die Abfragen kein
# maschinelles Muster bilden.
JITTER=0.25
# Artikel, die älter als diese Sekundenzahl sind, werden nicht gemeldet.
# Verhindert Alerts, wenn Vinted Altbestand neu einsortiert. 0 = aus.
MAX_ITEM_AGE=900

# ------------------------------------------------------------ Antibot / Netz
# Browser-Profil für die TLS-Impersonation (curl_cffi). Bei Problemen mal
# chrome131, chrome120 oder safari17_0 probieren.
IMPERSONATE=chrome124
# Proxys. Bei 403/429 schaltet der Sniper selbst auf den nächsten weiter.
#
# Kleine Listen hier, komma-getrennt. Große Listen gehören in eine Datei
# (PROXIES_FILE) — eine Umgebungsvariable mit tausenden Einträgen ist
# unbrauchbar.
#
# Beide Schreibweisen werden verstanden:
#   http://benutzer:passwort@host:port
#   host:port:benutzer:passwort        (Webshare & Co.)
PROXIES=

# Datei mit einer Proxy-Zeile pro Zeile. Zeilen mit # sind Kommentare.
# Fehlt die Datei, läuft der Sniper ohne Proxy weiter.
PROXIES_FILE=proxies.txt
# Headless-Chromium als Notnagel, wenn der HTTP-Bootstrap an einer Challenge
# scheitert. Ohne das steht der Bot bei einer Sperre still.
PLAYWRIGHT_FALLBACK=true
# Obergrenze der Requests pro Minute und Vinted-Domain über alle Suchen hinweg.
RATE_LIMIT_PER_DOMAIN=60
REQUEST_TIMEOUT=20

# ---------------------------------------------------------------- Sonstiges
DB_PATH=data/sniper.db
LOG_LEVEL=INFO
