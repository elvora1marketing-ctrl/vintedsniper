# ---------------------------------------------------------------- Discord
# Bot-Token aus dem Discord Developer Portal (Application → Bot → Reset Token).
DISCORD_TOKEN=

# Server-ID (Rechtsklick auf den Server → "Server-ID kopieren", Entwicklermodus
# muss an sein). Gesetzt: Slash-Commands sind sofort da. Leer: global, kann bis
# zu einer Stunde dauern.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------- Polling
# Standard-Prüfintervall neuer Suchen in Sekunden.
DEFAULT_INTERVAL=60
# Untergrenze, die per /watch interval nicht unterschritten werden kann.
# Unter ~20s steigt das Sperrrisiko deutlich, ohne dass man real schneller ist.
MIN_INTERVAL=20
# Artikel pro Abfrage. 20 reicht — wer mehr braucht, pollt zu langsam.
PER_PAGE=20
# Zufälliger Anteil auf jedes Intervall (0.25 = ±25 %), damit die Abfragen kein
# maschinelles Muster bilden.
JITTER=0.25
# Artikel, die älter als diese Sekundenzahl sind, werden nicht gemeldet.
# Verhindert Alerts, wenn Vinted Altbestand neu einsortiert. 0 = aus.
MAX_ITEM_AGE=900

# ------------------------------------------------------------ Antibot / Netz
# Browser-Profil für die TLS-Impersonation (curl_cffi). Bei Problemen mal
# chrome131, chrome120 oder safari17_0 probieren.
IMPERSONATE=chrome124
# Optionale Proxys, komma-getrennt. Bei 403/429 wird automatisch rotiert.
# Beispiel: http://user:pass@host:8000,http://user:pass@host:8001
PROXIES=
# Headless-Chromium als Notnagel, wenn der HTTP-Bootstrap an einer Challenge
# scheitert. Ohne das steht der Bot bei einer Sperre still.
PLAYWRIGHT_FALLBACK=true
# Obergrenze der Requests pro Minute und Vinted-Domain über alle Suchen hinweg.
RATE_LIMIT_PER_DOMAIN=60
REQUEST_TIMEOUT=20

# ---------------------------------------------------------------- Sonstiges
DB_PATH=data/sniper.db
LOG_LEVEL=INFO
