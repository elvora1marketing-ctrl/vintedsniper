# ---------------------------------------------------------------- Discord
#
# Du brauchst MINDESTENS EINES von beidem:
#
#   ALERT_WEBHOOK_URL  → schnellster Weg. Kein Bot, kein Token, keine Rechte.
#                        Suchen stehen dann in searches.toml.
#   DISCORD_TOKEN      → voller Bot mit Slash-Commands (/watch add …).
#
# Beides gesetzt geht auch: dann gibt es Slash-Commands, und Suchen aus
# searches.toml laufen zusätzlich über den Webhook.

# Channel-Einstellungen → Integrationen → Webhooks → Neuer Webhook → URL kopieren.
ALERT_WEBHOOK_URL=

# Suchdefinitionen für den Webhook-Modus (Vorlage: searches.example.toml).
SEARCHES_PATH=searches.toml

# Bot-Token aus dem Discord Developer Portal (Application → Bot → Reset Token).
DISCORD_TOKEN=

# Server-ID — optional. Leer lassen genügt: der Bot registriert die Befehle
# dann selbst auf allen Servern, auf denen er ist. Nur nötig, wenn er auf
# vielen Servern läuft und die Befehle bloß auf einem erscheinen sollen.
DISCORD_GUILD_ID=

# ------------------------------------------------------------- Web-Panel
# Oberfläche zum Verwalten der Suchen im Browser. Alerts kommen weiterhin
# ausschließlich in Discord an — das Panel zeigt an und verwaltet.
#
# Leeres Passwort = Panel bleibt aus. Nimm etwas Langes; die Adresse ist
# öffentlich erreichbar.
PANEL_PASSWORD=

# Domain fürs Panel. Muss per DNS-A-Eintrag auf diesen Server zeigen.
# Wird nur vom mitgelieferten Caddy benutzt (`--profile standalone`); läuft auf
# dem Server schon ein Reverse-Proxy, kennt der seine Domain selbst.
PANEL_DOMAIN=vinted.example.de

# Port auf 127.0.0.1 des Hosts, über den ein Reverse-Proxy das Panel erreicht.
# Nur ändern, wenn der Port schon belegt ist.
PANEL_PORT=8080

# ---------------------------------------------------------- Kaufprofile
# Datei mit den Kaufprofilen: Produktzuschnitt, erwarteter Verkaufspreis,
# Kosten und Gewinnschwellen. Fehlt sie, meldet der Sniper jeden neuen
# Treffer; mit ihr nur noch, was nach allen Kosten genug übrig lässt.
#   cp profiles.example.toml profiles.toml
PROFILES_PATH=profiles.toml

# ------------------------------------------------------- Was gemeldet wird
# Der Unterschied zwischen einem Alert-Bot und einem Werkzeug zum
# Weiterverkaufen: nicht jeder neue Treffer ist Geld wert.
#
# Der Sniper sammelt nebenbei die Preise aller Artikel, die seine Suchen
# sehen, und hält jeden neuen Fund gegen den Median dieser Sammlung.
# MIN_DISCOUNT=30 meldet nur noch, was mindestens 30 % darunter liegt.
# 0 = alles melden (Standard).
#
# Wichtig: Das ist der Median der *Angebotspreise*, nicht der erzielten
# Verkaufspreise — die gibt Vinted nicht heraus. Und er taugt nur so viel wie
# die Suche eng ist: „Nike" mischt Socken mit Sneakern, „Nike Air Max 90
# Gr. 44" nicht. Unter 25 Vergleichswerten wird nicht gefiltert, sondern
# gesammelt und alles gemeldet.
MIN_DISCOUNT=0

# Zeitfenster der Vergleichspreise in Tagen.
PRICE_WINDOW_DAYS=30

# Artikel unter diesem Preis überspringen. 0 = aus.
MIN_PRICE=0

# Wörter im Titel, die einen Artikel aussortieren. Komma-getrennt,
# Groß-/Kleinschreibung egal. Beispiel:
#   EXCLUDE_WORDS=defekt,kaputt,riss,fleck,fake,replica,nachbau,bitte lesen
EXCLUDE_WORDS=

# Artikel ohne Foto überspringen — beim Weiterverkauf unbrauchbar.
REQUIRE_PHOTO=false

# ---------------------------------------------------------------- Länder
# Jede Suche läuft automatisch zusätzlich in diesen Ländern — auch die, die
# schon angelegt sind. Derselbe Artikel kostet in Frankreich oder Italien oft
# deutlich weniger; wer nur .de beobachtet, sieht ihn nie.
#
# Kürzel durch Komma trennen. Erkannt werden alle 22 Vinted-Länder:
#   de at fr be lu nl es it pt ie gr fi sk lt uk pl cz se dk ro hu com
# Leer = nur die Domain aus der jeweiligen Such-URL.
#
# Achtung: Jedes Land ist eine eigene Suche mit eigenem Abfragetakt. Fünf
# Länder bei drei Suchen sind achtzehn Suchen — bei zu kurzem Intervall wird
# das Vinted auffallen. 60s oder mehr sind hier vernünftig.
EXTRA_COUNTRIES=

# Vinted vergibt Artikel-IDs länderübergreifend: derselbe Artikel hat auf .de
# und .fr dieselbe ID. Ohne Entdopplung meldet ihn jede Länderkopie einzeln.
#   group  = nur einmal je Suche, egal in wie vielen Ländern sie läuft (Standard)
#   all    = nur einmal überhaupt, auch über verschiedene Suchen hinweg
#   watch  = keine Entdopplung, jede Suche meldet für sich
DEDUPE_SCOPE=group

# ----------------------------------------------------------- Überwachung
# Damit du merkst, wenn der Sniper nicht mehr läuft.
#
# Wen der Bot bei einem Ausfall anpingt. Discord pingt NICHT über den Namen,
# sondern über die Benutzer-ID: in Discord Einstellungen → Erweitert →
# Entwicklermodus einschalten, dann Rechtsklick auf deinen Namen →
# „Benutzer-ID kopieren". Mehrere durch Komma trennen.
# `@here` geht auch. Leer = keine Erwähnung, nur eine Nachricht.
#   ALERT_MENTION=123456789012345678,987654321098765432
ALERT_MENTION=

# Channel für Ausfallmeldungen (Channel-ID, gleicher Weg wie oben).
# Leer = der Channel der ersten Suche bzw. ALERT_WEBHOOK_URL.
HEALTH_CHANNEL=

# Ab wann eine Suche als „meldet nichts mehr" gilt, in Sekunden. Gerechnet wird
# mit dem Größeren aus diesem Wert und dem dreifachen Suchintervall.
HEALTH_STALE_AFTER=900

# Abstand zwischen zwei Prüfungen, in Sekunden.
HEALTH_EVERY=300

# Totmannschalter — die einzige Stufe, die einen toten Server bemerkt.
#
# Der Bot kann sich nicht selbst melden, wenn er nicht läuft. Deshalb pingt er
# jede Minute diese URL an; bleibt der Ping aus, schlägt der fremde Dienst
# Alarm. Kostenlos geht das z. B. mit healthchecks.io:
#   1. Konto anlegen, „Add Check", Periode 5 Minuten, Grace 5 Minuten
#   2. Ping-URL kopieren und hier eintragen
#   3. Bei „Integrations" Discord verbinden — dann schreibt der Dienst selbst
#      in deinen Channel, auch wenn dein Server komplett aus ist.
# Leer = aus.
HEARTBEAT_URL=

# ------------------------------------------------------------- Aufräumen
# Ein Sniper-Channel läuft schnell voll. Alerts, die älter sind als das,
# werden automatisch gelöscht. 0 = aus, 24 = ein Tag.
# Der Bot braucht dafür im Channel das Recht „Nachrichten verwalten".
ALERT_RETENTION_HOURS=0

# In welchen Channels aufgeräumt wird. Leer = in allen, in die der Bot selbst
# alertet. Im Webhook-Modus muss die ID hier stehen: aus einer Webhook-URL
# lässt sich der Channel nicht ableiten. Mehrere durch Komma trennen.
# ID holen: in Discord Entwicklermodus einschalten, Rechtsklick auf den
# Channel → „Channel-ID kopieren".
CLEANUP_CHANNELS=

# ---------------------------------------------------------------- Polling
# Standard-Prüfintervall neuer Suchen in Sekunden.
DEFAULT_INTERVAL=60
# Untergrenze, die per /watch interval nicht unterschritten werden kann.
# Unter ~20s steigt das Sperrrisiko deutlich, ohne dass man real schneller ist.
MIN_INTERVAL=20
# Artikel pro Abfrage. 20 reicht — wer mehr braucht, pollt zu langsam.
PER_PAGE=20
# Zufälliger Anteil auf jedes Intervall (0.25 = ±25 %), damit die Abfragen kein
# maschinelles Muster bilden.
JITTER=0.25
# Artikel, die älter als diese Sekundenzahl sind, werden nicht gemeldet.
# Verhindert Alerts, wenn Vinted Altbestand neu einsortiert. 0 = aus.
MAX_ITEM_AGE=900

# ------------------------------------------------------------ Antibot / Netz
# Browser-Profil für die TLS-Impersonation (curl_cffi). Bei Problemen mal
# chrome131, chrome120 oder safari17_0 probieren.
IMPERSONATE=chrome124
# Proxys. Bei 403/429 schaltet der Sniper selbst auf den nächsten weiter.
#
# Kleine Listen hier, komma-getrennt. Große Listen gehören in eine Datei
# (PROXIES_FILE) — eine Umgebungsvariable mit tausenden Einträgen ist
# unbrauchbar.
#
# Beide Schreibweisen werden verstanden:
#   http://benutzer:passwort@host:port
#   host:port:benutzer:passwort        (Webshare & Co.)
PROXIES=

# Datei mit einer Proxy-Zeile pro Zeile. Zeilen mit # sind Kommentare.
# Fehlt die Datei, läuft der Sniper ohne Proxy weiter.
PROXIES_FILE=proxies.txt

# Sitzungsvorlage — für Anbieter, die keine Proxy-Liste vergeben, sondern
# durchnummerierte Sitzungen: `benutzer-DE-1`, `benutzer-DE-2`, … Jede Nummer
# bekommt eine eigene IP aus demselben Pool.
#
# Statt tausende fast identischer Zeilen zu pflegen, steht hier die Vorlage;
# `{n}` wird durch 1 bis PROXIES_SESSIONS ersetzt.
#   PROXIES_TEMPLATE=p.webshare.io:80:ckrgzvap-DE-{n}:deinpasswort
#   PROXIES_SESSIONS=4577
#
# Wichtig: Mehr Sitzungen heißen NICHT mehr Datenvolumen. Das Kontingent gilt
# fürs Konto, nicht je Sitzung — ist es aufgebraucht, liefern alle HTTP 402.
# Was viele Sitzungen bringen: verschiedene IPs, also weniger Sperren.
PROXIES_TEMPLATE=
PROXIES_SESSIONS=0
# Headless-Chromium als Notnagel, wenn der HTTP-Bootstrap an einer Challenge
# scheitert. Ohne das steht der Bot bei einer Sperre still.
PLAYWRIGHT_FALLBACK=true
# Obergrenze der Requests pro Minute und Vinted-Domain über alle Suchen hinweg.
RATE_LIMIT_PER_DOMAIN=60
REQUEST_TIMEOUT=20

# ---------------------------------------------------------------- Sonstiges
DB_PATH=data/sniper.db
LOG_LEVEL=INFO
